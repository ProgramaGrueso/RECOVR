# Copia este archivo como backend/.env y completa los valores. backend/.env NO se sube a git.
# Genera secretos con:  openssl rand -base64 48

# --- Base de datos (docker compose y backend) ---
DB_ROOT_PASSWORD=
DB_USERNAME=recovr
DB_PASSWORD=
# Para correr el backend fuera de Docker (mvn spring-boot:run) contra el MySQL de docker compose:
DB_URL=jdbc:mysql://localhost:3306/recovr_db?useSSL=false&allowPublicKeyRetrieval=true
DB_POOL_MAX=10

# --- Seguridad ---
# Base64 de 32 bytes o más. Obligatoria en el perfil prod (y la misma en todas las réplicas).
JWT_SECRET=
# Orígenes del frontend que pueden llamar a la API, separados por coma (admite patrones como https://recovr-*.vercel.app).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Primer administrador (solo si aún no existe ninguno; deberá cambiar la clave al ingresar) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Datos de demostración (solo desarrollo) ---
SEED_DEMO_DATA=false
# Contraseña de las cuentas demo (mín. 10 caracteres, letras y números). Vacía = no se crean cuentas demo.
DEMO_PASSWORD=

# --- Opcionales ---
DEEPSEEK_API_KEY=
API_PORT=8095
