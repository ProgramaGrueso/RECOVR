# Copia este archivo a .env y ajusta lo que necesites. Todo es opcional para una prueba rápida.
WEB_PORT=4200
DB_PASSWORD=cambia-esta-clave
# openssl rand -base64 48   (si lo dejas vacío, se genera una clave temporal y las sesiones se pierden al reiniciar)
JWT_SECRET=
# true = catálogo, personal, clientes y reservas de demostración. false = modo real, sin datos de prueba.
SEED_DEMO_DATA=true
# Primer administrador (modo real). Contraseña: mínimo 8 caracteres, con letras y números.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Asistente con IA de la web (opcional). Sin clave, el chat dirige a WhatsApp.
DEEPSEEK_API_KEY=
